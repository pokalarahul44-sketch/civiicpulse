# Copy to .env. The default demo makes no Google API calls.
AI_MODE=demo
STORAGE_MODE=local
PORT=8080
# Live setup: AI_MODE=vertex; STORAGE_MODE=firestore
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Set an available Gemini Flash model ID from Vertex AI Model Garden.
GEMINI_MODEL=

# Optional local storage directory; defaults to project-root/data.
# DATA_DIR=
